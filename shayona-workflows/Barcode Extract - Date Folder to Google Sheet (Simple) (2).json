    {
      "parameters": {
        "jsCode": "const validItems = items.filter(item => {\n  const name = (item.json.name || '').trim();\n  return /^[0-9]{4,20}$/.test(name);\n});\n\nvalidItems.sort((a, b) => {\n  return Number(a.json.name) - Number(b.json.name);\n});\n\nreturn validItems.map(item => ({\n  json: {\n    Barcode: item.json.name.trim(),\n    \"Folder ID\": item.json.id\n  }\n}));"
      },
