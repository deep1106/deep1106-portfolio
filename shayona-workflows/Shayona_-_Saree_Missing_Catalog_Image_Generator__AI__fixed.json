    },
    {
      "parameters": {
        "jsCode": "const files = $input.all();\nconst folderId = $('Loop Barcode Folders').item.json.barcodeFolderId;\nconst barcodeName = $('Loop Barcode Folders').item.json.barcodeName;\n\nconst allFiles = files.map(item => item.json).filter(f => f && f.name);\n\nfunction findByRole(role) {\n  const exact = allFiles.find(f => f.name.trim().toLowerCase() === `${role}.png`);\n  if (exact) return exact;\n  const re = new RegExp(`^.+\\\\s*-\\\\s*${role}\\\\.png$`, 'i');\n  return allFiles.find(f => re.test(f.name.trim())) || null;\n}\n\nconst sareeFile = findByRole(5);\nconst blouseFile = findByRole(6);\nconst existing2 = findByRole(2);\n\nconst hasSaree = !!sareeFile;\nconst hasBlouseFabric = !!blouseFile;\n\nlet missingReason = '';\nif (!hasSaree && !hasBlouseFabric) missingReason = 'Missing 5.png and 6.png';\nelse if (!hasSaree) missingReason = 'Missing 5.png';\nelse if (!hasBlouseFabric) missingReason = 'Missing 6.png';\n\nreturn [{\n  json: {\n    barcodeFolderId: folderId,\n    barcodeName: barcodeName,\n    hasSaree,\n    hasBlouseFabric,\n    hasRequiredImages: hasSaree && hasBlouseFabric,\n    sareeFileId: sareeFile ? sareeFile.id : null,\n    blouseFabricFileId: blouseFile ? blouseFile.id : null,\n    existing2PngId: existing2 ? existing2.id : null,\n    missingReason\n  }\n}];"
      },
