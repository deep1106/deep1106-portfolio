        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.successLog) staticData.successLog = [];\nconst context = $('Map & Validate Images').item.json;\nconst entry = {\n  barcodeFolderId: context.barcodeFolderId,\n  barcodeName: context.barcodeName,\n  status: 'Done',\n  completedAt: new Date().toISOString()\n};\nstaticData.successLog.push(entry);\nreturn { json: entry };"
