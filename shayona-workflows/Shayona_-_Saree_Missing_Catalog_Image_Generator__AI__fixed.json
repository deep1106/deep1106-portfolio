    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst sareeBinary = $('Download Saree Image (5.png)').item.binary && $('Download Saree Image (5.png)').item.binary.data;\nconst blouseBinary = $('Download Blouse Fabric (6.png)').item.binary && $('Download Blouse Fabric (6.png)').item.binary.data;\n\nif (!sareeBinary) {\n  throw new Error('Saree image (5.png) binary data not found');\n}\nif (!blouseBinary) {\n  throw new Error('Blouse fabric image (6.png) binary data not found');\n}\n\nreturn {\n  json: { ...item.json },\n  binary: {\n    saree: sareeBinary,\n    blouse: blouseBinary\n  }\n};"
      },
      "id": "788df2b1-5977-43ba-89cf-6a4125fbcd48",
      "name": "Prepare Catalog Images",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3840,
        624
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst err = item.json.error || item.json;\nconst message = (typeof err === 'string') ? err : (err.message || JSON.stringify(err));\nconst statusCode = (item.json.error && (item.json.error.httpCode || item.json.error.statusCode)) || null;\nconst lower = (message || '').toLowerCase();\n\nlet errorType = 'Network Error';\nif (statusCode === 429 || lower.includes('rate limit') || lower.includes('quota')) {\n  errorType = 'Rate Limit';\n} else if (lower.includes('safety') || lower.includes('blocked') || lower.includes('policy')) {\n  errorType = 'Safety Block';\n} else if (lower.includes('json') || lower.includes('parse')) {\n  errorType = 'Invalid JSON';\n} else if (lower.includes('image') && (lower.includes('process') || lower.includes('decode'))) {\n  errorType = 'Image Processing Error';\n}\n\nconst v = $('Map & Validate Images').item.json;\n\nreturn {\n  json: {\n    barcodeFolderId: v.barcodeFolderId,\n    barcodeName: v.barcodeName,\n    errorReason: message,\n    errorType,\n    failedNode: 'Generate Catalog Image (Gemini)',\n    failedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "45eb036a-a262-42bb-8719-b93706853c76",
      "name": "Classify Catalog Generation Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4736,
        864
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst context = $('Map & Validate Images').item.json;\nconst binaryKeys = Object.keys(item.binary || {});\nconst hasImage = binaryKeys.length > 0;\n\nconst out = {\n  json: {\n    ...context,\n    hasGeneratedCatalogImage: hasImage,\n    catalogExtractionError: hasImage ? null : 'Gemini node returned no binary image data'\n  }\n};\nif (hasImage) {\n  out.binary = item.binary;\n}\nreturn out;"
      },
