        "jsCode": "const v = $input.item.json;\nconst reason = v.catalogExtractionError || 'Unknown extraction error';\nconst lower = reason.toLowerCase();\nconst errorType = (lower.includes('safety') || lower.includes('block')) ? 'Safety Block' : 'Image Processing Error';\n\nreturn {\n  json: {\n    barcodeFolderId: v.barcodeFolderId,\n    barcodeName: v.barcodeName,\n    errorReason: reason,\n    errorType,\n    failedNode: 'Extract Generated Catalog Image',\n    failedAt: new Date().toISOString()\n  }\n};"
