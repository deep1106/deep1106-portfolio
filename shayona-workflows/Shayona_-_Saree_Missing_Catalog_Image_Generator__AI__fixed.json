    {
      "parameters": {
        "jsCode": "const folders = $input.all();\nconst results = [];\nfor (const item of folders) {\n  const f = item.json;\n  if (f.mimeType && f.mimeType !== 'application/vnd.google-apps.folder') continue;\n  if (!f.id) continue;\n  results.push({\n    json: {\n      barcodeFolderId: f.id,\n      barcodeName: f.name || f.id\n    }\n  });\n}\nreturn results;"
      },
      "id": "2bf297d4-1175-49a2-84b5-c8ecb977e197",
      "name": "Build Barcode Folder List",
