      "id": "88f13699-4002-4e91-a5bc-0410c13445a6",
      "name": "List Files In Barcode Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1376,
        912
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": <REDACTED>,
          "name": <REDACTED>
        }
